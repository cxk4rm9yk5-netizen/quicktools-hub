  <script>
    "use strict";

    const $ = (id) => document.getElementById(id);

    $("year").textContent = new Date().getFullYear();

    // Currency converter: uses a public exchange-rate API.
    $("convertCurrency").addEventListener("click", async () => {
      const amount = Number($("currencyAmount").value);
      const from = $("fromCurrency").value;
      const to = $("toCurrency").value;
      const output = $("currencyResult");

      if ($("currencyAmount").value.trim() === "" ||
          !Number.isFinite(amount) || amount < 0) {
        output.textContent = "Please enter a valid amount of zero or more.";
        return;
      }

      if (from === to) {
        output.textContent = `${amount} ${from} = ${amount.toLocaleString()} ${to}`;
        return;
      }

      output.textContent = "Getting the latest available exchange rate...";

      try {
        const response = await fetch(
          `https://open.er-api.com/v6/latest/${encodeURIComponent(from)}`
        );

        if (!response.ok) {
          throw new Error("Exchange-rate service is unavailable.");
        }

        const data = await response.json();

        if (data.result !== "success" || !data.rates ||
            typeof data.rates[to] !== "number") {
          throw new Error("Exchange rate not available for this currency.");
        }

        const rate = data.rates[to];
        const converted = amount * rate;

        output.textContent =
          `${amount.toLocaleString()} ${from} = ` +
          `${converted.toLocaleString(undefined, {
            maximumFractionDigits: 4
          })} ${to}. Rate: 1 ${from} = ${rate} ${to}.`;
      } catch (error) {
        output.textContent =
          "Sorry, the exchange rate could not be loaded. Please check your " +
          "internet connection and try again later.";
      }
    });

    // Age calculator.
    $("calculateAge").addEventListener("click", () => {
      const value = $("birthDate").value;
      const output = $("ageResult");

      if (!value) {
        output.textContent = "Please enter your date of birth.";
        return;
      }

      const birth = new Date(value + "T00:00:00");
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      if (Number.isNaN(birth.getTime()) || birth > today) {
        output.textContent = "Please enter a valid date that is not in the future.";
        return;
      }

      let years = today.getFullYear() - birth.getFullYear();
      let months = today.getMonth() - birth.getMonth();
      let days = today.getDate() - birth.getDate();

      if (days < 0) {
        months--;
        const previousMonthDays = new Date(
          today.getFullYear(), today.getMonth(), 0
        ).getDate();
        days += previousMonthDays;
      }

      if (months < 0) {
        years--;
        months += 12;
      }

      output.textContent =
        `Your age is ${years} years, ${months} months, and ${days} days.`;
    });

    // Percentage calculator.
    $("calculatePercentage").addEventListener("click", () => {
      const pText = $("percentageValue").value.trim();
      const nText = $("percentageNumber").value.trim();
      const output = $("percentageResult");

      const p = Number(pText);
      const n = Number(nText);

      if (pText === "" || nText === "" ||
          !Number.isFinite(p) || !Number.isFinite(n)) {
        output.textContent = "Please enter a valid percentage and number.";
        return;
      }

      const answer = (p / 100) * n;

      output.textContent =
        `${p}% of ${n} is ${answer.toLocaleString(undefined, {
          maximumFractionDigits: 8
        })}.`;
    });

    // Date difference calculator, using UTC to avoid daylight-saving errors.
    $("calculateDate").addEventListener("click", () => {
      const startValue = $("startDate").value;
      const endValue = $("endDate").value;
      const output = $("dateResult");

      if (!startValue || !endValue) {
        output.textContent = "Please select both dates.";
        return;
      }

      const start = Date.parse(startValue + "T00:00:00Z");
      const end = Date.parse(endValue + "T00:00:00Z");

      if (!Number.isFinite(start) || !Number.isFinite(end)) {
        output.textContent = "Please enter valid dates.";
        return;
      }

      const days = Math.abs(end - start) / 86400000;

      output.textContent =
        `The difference is ${days.toLocaleString()} day(s). ` +
        "This calculation does not count both endpoints as separate days.";
    });

    // Length converter: convert through meters.
    const metersPerUnit = {
      meters: 1,
      kilometers: 1000,
      centimeters: 0.01,
      millimeters: 0.001,
      miles: 1609.344,
      yards: 0.9144,
      feet: 0.3048,
      inches: 0.0254
    };

    $("convertUnit").addEventListener("click", () => {
      const valueText = $("unitValue").value.trim();
      const value = Number(valueText);
      const from = $("fromUnit").value;
      const to = $("toUnit").value;
      const output = $("unitResult");

      if (valueText === "" || !Number.isFinite(value)) {
        output.textContent = "Please enter a valid number.";
        return;
      }

      const result =
        value * metersPerUnit[from] / metersPerUnit[to];

      output.textContent =
        `${value.toLocaleString()} ${from} = ` +
        `${result.toLocaleString(undefined, {
          maximumFractionDigits: 8
        })} ${to}.`;
    });
  </script>
